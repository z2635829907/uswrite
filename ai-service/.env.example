# 对话大模型(OpenAI 兼容协议,默认 DeepSeek)
# 也可用 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 覆盖
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 向量模型(独立配置;DeepSeek 不提供 embedding,留空则退化为纯 BM25 检索)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v3

# JWT(必须与 Spring 端 app.jwt.secret 一致)
JWT_SECRET=shiguang-blog-jwt-secret-key-2026-change-me-in-production

# MySQL(与 Spring 端 datasource 一致)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=shiguang

# 服务
HOST=127.0.0.1
PORT=8000
