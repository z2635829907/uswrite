# ===== AI 助手服务配置模板 =====
# 复制为 .env 并填入真实值;.env 已在 .gitignore 中排除,请勿提交。

# ---- 对话大模型(OpenAI 兼容协议;当前使用阿里通义 qwen) ----
# 也可用 DEEPSEEK_* / SPRING_LLM_* 命名(兼容 Java 端)
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash

# ---- 向量模型(独立配置,可复用同一把 Key) ----
# 留空则退化为纯 BM25 关键词检索(服务仍可用)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3

# ---- JWT(必须与 Spring 端 app.jwt.secret 一致,用于鉴权互认) ----
JWT_SECRET=shiguang-blog-jwt-secret-key-2026-change-me-in-production

# ---- MySQL(与 Spring 端 datasource 一致) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=shiguang

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000
